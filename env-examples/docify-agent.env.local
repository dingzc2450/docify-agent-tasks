# dev-shell 本地调试环境变量
# 仅供本地开发使用，不参与生产构建

# ─────────────────────────────────────────────────────────────────
# 后端代理（Fastify，scripts/proxy-server.cjs）
# 切换本地 / 线上后端只改 PROXY_DOCIFY_NEXT_UPSTREAM 这一行，然后重启 proxy。
# ─────────────────────────────────────────────────────────────────
PROXY_PORT=3016
# Java 后端（登录 / 鉴权 / 业务）——通常固定指向远端，不随 agent 切换：
PROXY_DOCIFY_UPSTREAM=https://dev.docify.jp/docify
# Agent 后端（当前开发目标）——切换本地 / 线上只改这一行：
# 线上 DEV 环境：
PROXY_DOCIFY_NEXT_UPSTREAM=https://dev.docify.jp/docify-next
# 本地后端（start_backend.ps1 启动后监听 8502）：
# PROXY_DOCIFY_NEXT_UPSTREAM=http://localhost:8502

# 可选：无登录态调试时给后端请求补 Bearer Token（服务端变量，不进浏览器 bundle）。
# 注意：docify-test-token-123 是「本地 agent 后端」专用静态 token（配套 DOCIFY_TEST_TOKEN），
# 只在 PROXY_DOCIFY_NEXT_UPSTREAM 指向 http://localhost:8502 时才有效。
# 指向线上 DEV（https://dev.docify.jp/docify-next）时必须留空，
# 否则代理会强制注入这个假 token 覆盖 OAuth JWT，线上后端一律返回 401。
DEV_BEARER_TOKEN=

# ─────────────────────────────────────────────────────────────────
# 自动登录账号（代理用它调用 Java 后端 /oauth2/token 换取真实 token）
# 代理是独立 node 进程，直接读 .env.local，凭据不进入浏览器 bundle。
# ─────────────────────────────────────────────────────────────────
# 权限多多账号
# AUTH_USERNAME=chao.yan@huilianyi.com
# AUTH_PASSWORD=hly123
# 数据多多账号
AUTH_USERNAME=lte@function-test.com
AUTH_PASSWORD=Hly12345
# AUTH_SECRET 在 docify-web 里同时充当两用：
#   1) oauth2/token 的 Basic 客户端凭据头（代理登录用）
#   2) next-auth 的签名 secret（web-boot signOut 用，缺失会 MissingSecret 500）
# 因此必须设为这个 Basic 串，不能随便填占位值（否则登录 401）。
AUTH_SECRET=Basic ZG9jaWZ5LXdlYjo1MlM0cFdKY29SaWZRMmhMNjYwckpsSGFrcjFDTmF4VEtMeUtHZFI2
# 显式空 base path，避免 env('NEXT_PUBLIC_BASE_PATH') 为 undefined 拼出 /main/undefined
NEXT_PUBLIC_BASE_PATH=

# ─────────────────────────────────────────────────────────────────
# 前端 API base：全部指向本机代理，浏览器不直连远端（避免 CORS / cookie 域问题）。
#   NEXT_PUBLIC_API_URL  → agent 后端（/docify-next 前缀）
#   NEXT_PUBLIC_BASE_URL → Java 后端 bare origin，请求走 /api、/oauth2
# 这两个值由 web-boot 的 next-runtime-env env() 在客户端读取，
# 必须配合 layout 里的 <PublicEnvScript /> 才能生效。
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3016/docify-next
NEXT_PUBLIC_BASE_URL=http://localhost:3016

# 单一代理转发模式：DevAuthGate 始终从代理 /__dev_auth/session 取 token 写入页面，再拉真实用户。
# 切换本地 / 线上后端只改 PROXY_DOCIFY_NEXT_UPSTREAM，无需前端认证模式开关。
NEXT_PUBLIC_AGENT_TENANT_ID=1911967735017730049

# Admin 联调地址
NEXT_PUBLIC_AGENT_ADMIN_BASE_URL=http://127.0.0.1:3101

# Office 预览
NEXT_PUBLIC_OFFICE_PREVIEW_URL=https://dev.docify.jp/kkview/onlinePreview
