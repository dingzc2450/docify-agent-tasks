# app/web 与 app/admin 共用的 dev 环境变量记录（仓库目录：apps/web、apps/admin）。
# 来源：MYD-364 附件 .env.local；两端共用同一 Java 后端与登录账号。
# 以下保留附件原配置（web 默认 3015）；admin 默认 3010，同源绝对地址按实际端口调整。

# apps/web 本地开发环境变量（加载顺序：shell 环境 > .env.local > .env.development > .env）。
# 完整变量清单与消费方说明见仓库根目录 ENV.md；本地 dev 由 packages/dev-toolkit 单进程
# launcher 承载（Next + 代理 + 自动登录同端口，web 默认 3015）。

# ── 后端上游（launcher 代理转发目标）─────────────────────────────
# Java 后端（/api、/oauth2 上游；oauth2/token 自动登录同样取此基址）
BASE_URL=https://dev.docify.cn/docify
# Agent 后端（/docify-next 上游）；本地联调 Agent 后端时切换为 http://localhost:8502
PROXY_DOCIFY_NEXT_UPSTREAM=https://dev.docify.cn/docify-next
# PROXY_DOCIFY_NEXT_UPSTREAM=http://127.0.0.1:8502
# 模拟公网客户端 IP（调试地区敏感链路：GeoIP/语言/地区/合规；合法 IPv4/IPv6，
# 仅本地 Agent upstream 生效；用法详见 apps/web/.env.example 与根目录 ENV.md）
# PROXY_DOCIFY_NEXT_CLIENT_IP=133.130.0.1

# ── 监听端口 ────────────────────────────────────────────────
# 缺省用 launcher 默认 3015（apps/admin 默认 3010）；需要固定时打开下行
# PROXY_PORT=3015

# ── 自动登录（launcher /__dev_auth/session；服务端变量，不进浏览器 bundle）──
AUTH_USERNAME=986409700@qq.com
AUTH_PASSWORD=Hly12345
AUTH_SECRET=Basic ZG9jaWZ5LXdlYjo1MlM0cFdKY29SaWZRMmhMNjYwckpsSGFrcjFDTmF4VEtMeUtHZFI2

# AUTH_USERNAME=
# AUTH_PASSWORD=
# ── 基址 ────────────────────────────────────────────────────
# dev 模式下页面请求全部走 launcher 同源相对路径，此值不影响请求目标；
# 仅 publish-chat-dialog 的 embed 预览片段消费，需指向 launcher 同源
NEXT_PUBLIC_BASE_URL=http://localhost:3015
# # Agent 后端基址（report-shell 场景资源代理等 server 端消费，经 launcher 代理）
NEXT_PUBLIC_API_URL=http://localhost:3015/docify-next

# ── 功能开关 / 预览 ──────────────────────────────────────────
NEXT_PUBLIC_PHONE_ENABLED=true
# next/image 远程图片白名单（逗号分隔；当前与 kkview 预览服务端口一致）
TRUSTED_HOST=localhost:3001
# NEXT_PUBLIC_OFFICE_PREVIEW_URL=http://localhost:3015/kkview/onlinePreview
# 与本地 kkFileView 的 base.url 保持一致，避免嵌套 iframe 混用 localhost 与 127.0.0.1。
NEXT_PUBLIC_OFFICE_PREVIEW_URL=http://127.0.0.1:8012/kkview/onlinePreview

NEXT_PUBLIC_UNIVER_XLSX_PILOT=true


